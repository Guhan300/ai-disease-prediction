# Application
APP_NAME=MedAI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dataset & ML artifacts (Phase 2+)
DATASET_PATH=backend/data/raw/disease_dataset.csv
TARGET_COLUMN=prognosis
PRIMARY_METRIC=macro_f1
MODEL_PATH=backend/models/trained/best_model.joblib
PREPROCESSOR_PATH=backend/models/trained/preprocessor.joblib
MODEL_METADATA_PATH=backend/models/metadata/model_metadata.json

# Local LLM (Ollama) — Phase 4+
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# RAG / vector store — Phase 7+
VECTOR_STORE_PATH=backend/models/metadata/faiss_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KNOWLEDGE_BASE_PATH=backend/knowledge_base/medical_documents

# Database
DATABASE_URL=sqlite:///./app.db

# Logging
LOG_LEVEL=INFO
